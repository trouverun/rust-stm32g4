CM_ "0x100-0x1FF device reports, 0x200-0x2FF host commands. Messages are listed Host-transmitted first, then Firmware-transmitted, alphabetical within each group.";
CM_ BO_ 512 "Checksum = CRC-8 (SAE J1850) over data bytes 0-2.";
CM_ BO_ 656 "Byte offset = counter * 6. Counter 0 restarts reception. Out-of-sequence chunks are dropped and acked.";
CM_ BO_ 504 "next_counter = first chunk not yet accepted.";
CM_ BO_ 672 "image_crc32 = CRC-32 (ISO-HDLC) over the first image_length bytes.";

BA_DEF_ BO_  "GenMsgCycleTime" INT 0 10000;
BA_DEF_ BO_  "GenMsgCycleTimeUs" INT 0 1000000;
BA_DEF_DEF_  "GenMsgCycleTime" 0;
BA_DEF_DEF_  "GenMsgCycleTimeUs" 0;
BA_ "GenMsgCycleTimeUs" BO_ 256 400;
